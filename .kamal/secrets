# Read by `kamal deploy` at deploy time. All values come from env vars
# exported by the kamal-ci dispatcher (leobrines/kamal-ci): KAMAL_REGISTRY_PASSWORD
# is the per-run GITHUB_TOKEN; every other `$VAR` below is looked up as an
# individual secret of the same name in kamal-ci's `app-beveganmotherfucker` GitHub
# Environment. Non-sensitive values belong in config/deploy.yml env.clear.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
